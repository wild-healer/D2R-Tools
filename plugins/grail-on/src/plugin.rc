D2RL_PLUGIN_MANIFEST_RESOURCE_ID RCDATA { D2RL_PLUGIN_RESOURCE_DWORD(D2RL_PLUGIN_ABI_VERSION) }

1 VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "FileDescription", "Grail On! D2RLoader plugin"
      VALUE "FileVersion", "1.0.0"
      VALUE "InternalName", "grail-on"
      VALUE "OriginalFilename", "d2rl-grail-on.dll"
      VALUE "ProductName", "Grail On!"
      VALUE "ProductVersion", "1.0.0"
      VALUE "LegalCopyright", "Icons by Lorc, Delapouite and contributors, game-icons.net, CC BY 3.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0409, 1200
  END
END

